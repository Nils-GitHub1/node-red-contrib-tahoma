{
  "name": "@nils-github1/node-red-contrib-tahoma",
  "version": "3.3.2",
  "description": "Control a Somfy TaHoma box from Node RED",
  "keywords": [
    "node",
    "red",
    "node-red",
    "tahoma",
    "somfy",
    "home",
    "automation"
  ],
  "homepage": "https://github.com/Nils-GitHub1/node-red-contrib-tahoma/",
  "bugs": {
    "url": "https://github.com/Nils-GitHub1/node-red-contrib-tahoma/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nils-GitHub1/node-red-contrib-tahoma.git"
  },
  "license": "Apache-2.0 AND MIT",
  "author": "Nicolas Nunge <me@nikkow.eu> (https://github.com/nikkow/node-red-contrib-tahoma)",
  "contributors": [
    {
      "name": "nils-github1",
      "url": "https://github.com/Nils-GitHub1/node-red-contrib-tahoma/"
    }
  ],
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build-windows": "mkdir .\\dist\\nodes && copy .\\src\\nodes\\*.html .\\dist\\nodes\\ && tsc",
    "build-linux": "mkdir -p dist/nodes/ && cp -a src/nodes/*.html dist/nodes/ && tsc",
    "build": "node -e \"require('fs').mkdirSync('dist/nodes', { recursive: true }); require('fs').readdirSync('src/nodes').filter(f => f.endsWith('.html')).forEach(f => require('fs').copyFileSync('src/nodes/' + f, 'dist/nodes/' + f))\" && npx tsc",
    "watch": "tsc --watch",
    "execute": "npm run build && node-red",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "axios": ">=0.26.1"
  },
  "devDependencies": {
    "@types/node": ">=22.13.0",
    "@types/node-red": ">=1.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": ">=10.0.0",
    "eslint-config-prettier": ">=10.0.0",
    "eslint-plugin-prettier": ">=5.5.0",
    "prettier": ">=3.6.2",
    "typescript": ">=5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "node-red": {
    "version": ">=3.1.0",
    "nodes": {
      "tahoma": "dist/nodes/tahoma.js",
      "tahoma-config": "dist/nodes/tahoma-config.js",
      "tahoma-read": "dist/nodes/tahoma-read.js",
      "tahoma-scenario-ctrl": "dist/nodes/tahoma-scenario-control.js",
      "tahoma-cloud-config": "dist/nodes/tahoma-cloud-config.js",
      "tahoma-scenarios": "dist/nodes/tahoma-scenarios.js"
    }
  }
}
